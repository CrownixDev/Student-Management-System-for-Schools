generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ENUMS
enum Gender {
  male
  female
}

enum SubjectCategory {
  core // Grade 6-11 core subjects
  ol_basket // Grade 10-11 basket subjects (categories I, II, III)
  religion
  al_main
  al_common
  other
}

enum StudentStatus {
  active
  left
}

enum EnrollmentStatus {
  active
  completed
  repeated
}

enum MarkStatus {
  present
  absent
}

enum UserRole {
  admin
  mod
  class_teacher
  subject_teacher
}

enum BatchType {
  ol
  al
}

// Models

model AcademicYear {
  id        String   @id @default(uuid())
  name      String   @unique // "2026"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  classes     Class[]
  enrollments Enrollment[]
  exams       Exam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// School Grade
model GradeLevel {
  id     String @id @default(uuid())
  number Int    @unique // 1..13
  name   String // "Grade 12"

  classes Class[]
  exams   Exam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Medium {
  id   String @id @default(uuid())
  name String @unique // Sinhala, English

  classesDefault     Class[]
  classSubjects      ClassSubject[]
  enrollmentSubjects EnrollmentSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Currently stream does not provide any real functionalities like grouping 
model Stream {
  id   String @id @default(uuid())
  name String @unique // Technology

  classes  Class[]
  subjects Subject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subject {
  id            String          @id @default(uuid())
  name          String
  code          String?         @unique
  category      SubjectCategory @default(other)
  ignoreRanking Boolean         @default(false)

  streams            Stream[]
  classSubjects      ClassSubject[]
  enrollmentSubjects EnrollmentSubject[]
  examSubjects       ExamSubject[]
  marks              Mark[]
  userSubjects       UserSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, category])
}

model Teacher {
  id       String  @id @default(uuid())
  fullName String
  phone    String?
  isActive Boolean @default(true)

  classesAsClassTeacher Class[]        @relation("ClassTeacher")
  classSubjects         ClassSubject[]
  user                  User?

  // TODO: the academic year and class teacher's class should be unique 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// O/L | A/L Grouping
model Batch {
  id   String    @id @default(uuid())
  name String    @unique // "2026"
  type BatchType @default(al)

  classes Class[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id              String  @id @default(uuid())
  academicYearId  String
  gradeLevelId    String
  streamId        String?
  name            String // "12 T2"
  defaultMediumId String?
  classTeacherId  String?
  batchId         String?

  academicYear  AcademicYear @relation(fields: [academicYearId], references: [id])
  gradeLevel    GradeLevel   @relation(fields: [gradeLevelId], references: [id])
  stream        Stream?      @relation(fields: [streamId], references: [id])
  defaultMedium Medium?      @relation(fields: [defaultMediumId], references: [id])
  classTeacher  Teacher?     @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  batch         Batch?       @relation(fields: [batchId], references: [id])

  classSubjects ClassSubject[]
  enrollments   Enrollment[]
  userClasses   UserClass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, gradeLevelId, name])
  @@index([gradeLevelId])
}

// This will act as a templete for student subject enrollment. 
model ClassSubject {
  id        String  @id @default(uuid())
  classId   String
  subjectId String
  mediumId  String?
  teacherId String

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])
  medium  Medium? @relation(fields: [mediumId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, subjectId])
  @@index([teacherId])
}

model Student {
  id            String    @id @default(uuid())
  admissionNo   String    @unique
  fullName      String
  dob           DateTime?
  gender        Gender?
  nic           String?
  phone         String?
  address       String?
  guardianName  String?
  guardianPhone String?

  status StudentStatus @default(active)

  enrollments Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
}

// A student in one class for one academic year.
model Enrollment {
  id String @id @default(uuid())

  studentId      String
  classId        String
  academicYearId String
  classIndex     Int
  status         EnrollmentStatus @default(active)

  joinedOn DateTime  @default(now())
  endedOn  DateTime?

  // helps with completed / repeat chain
  previousEnrollmentId String? @unique

  student            Student      @relation(fields: [studentId], references: [id])
  class              Class        @relation(fields: [classId], references: [id])
  academicYear       AcademicYear @relation(fields: [academicYearId], references: [id])
  previousEnrollment Enrollment?  @relation("PromotionChain", fields: [previousEnrollmentId], references: [id])
  nextEnrollment     Enrollment?  @relation("PromotionChain")

  subjects EnrollmentSubject[]
  marks    Mark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, academicYearId])
  @@index([classId])
}

// What subjects in which medium a student learn during a acadamic year.
model EnrollmentSubject {
  id           String  @id @default(uuid())
  enrollmentId String
  subjectId    String
  mediumId     String?

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id])
  medium     Medium?    @relation(fields: [mediumId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, subjectId])
}

// EXAMS & MARKS

model Exam {
  id             String @id @default(uuid())
  academicYearId String
  gradeLevelId   String
  name           String // "1st Term Test"

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  gradeLevel   GradeLevel   @relation(fields: [gradeLevelId], references: [id])

  examSubjects ExamSubject[]
  marks        Mark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, gradeLevelId, name])
  @@index([gradeLevelId])
}

model ExamSubject {
  id        String @id @default(uuid())
  examId    String
  subjectId String
  maxMarks  Float  @default(100)
  passMark  Float  @default(35)

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, subjectId])
}

model Mark {
  id           String @id @default(uuid())
  examId       String
  enrollmentId String
  subjectId    String

  marks  Float?
  status MarkStatus @default(present)

  exam       Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  subject    Subject    @relation(fields: [subjectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, enrollmentId, subjectId])
  @@index([enrollmentId])
  @@index([subjectId])
}

// Other app related things

model User {
  id           String @id @default(uuid())
  username     String @unique
  passwordHash String

  role     UserRole @default(admin)
  isActive Boolean  @default(true)

  refreshTokenHash      String? @unique
  refreshTokenExpiresAt String?

  teacherId String?  @unique // link login to a teacher record
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  classes  UserClass[]
  subjects UserSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserClass {
  id      String @id @default(uuid())
  userId  String
  classId String

  user  User  @relation(fields: [userId], references: [id])
  class Class @relation(fields: [classId], references: [id])
}

model UserSubject {
  id        String @id @default(uuid())
  userId    String
  subjectId String

  user    User    @relation(fields: [userId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
}
